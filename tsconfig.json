{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server/**/*.ts",
    "functions/**/*.ts",
    "github-ui.ts",
    "apps-ui.ts",
    "projects-ui.ts",
    "domains-ui.ts",
    "terminal-ui.ts",
    "revisions-ui.ts",
    "site-detail-ui.ts",
    "secrets-ui.ts"
  ]
}
